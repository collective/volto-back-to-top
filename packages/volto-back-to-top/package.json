{
  "name": "volto-back-to-top",
  "version": "1.0.0-alpha.0",
  "description": "A new add-on for Volto that include a button to go back to the top when you scroll down the page",
  "main": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "volto-addon",
    "volto",
    "plone",
    "react"
  ],
  "author": "Leonardo J. Caballero G.",
  "homepage": "https://github.com/collective/volto-back-to-top#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:collective/volto-back-to-top"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "i18n": "rm -rf build/messages && NODE_ENV=production i18n --addon",
    "dry-release": "release-it --dry-run",
    "release": "release-it",
    "release-major-alpha": "release-it major --preRelease=alpha",
    "release-alpha": "release-it --preRelease=alpha"
  },
  "addons": [
    "@kitconcept/volto-light-theme"
  ],
  "theme": "",
  "dependencies": {
    "@kitconcept/volto-light-theme": "7.8.6"
  },
  "peerDependencies": {
    "@plone/components": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@plone/components": "workspace:*",
    "@plone/registry": "workspace:*",
    "@plone/scripts": "workspace:*",
    "@plone/types": "workspace:*",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "release-it": "^19.0.5",
    "sass": "^1",
    "sass-loader": "^13",
    "typescript": "^5.7.3"
  }
}
